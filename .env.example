# Talent Bridge — variables d'environnement (copier en .env ; NE JAMAIS committer .env).
# Générer chaque secret avec : openssl rand -base64 32

# --- Base de données ---
DATABASE_URL=postgresql://talent:talent@localhost:5432/talentbridge
# Base dédiée aux tests d'intégration (vidée à chaque test — ne jamais pointer vers une base réelle)
TEST_DATABASE_URL=postgresql://talent:talent@localhost:5432/talentbridge_test

# --- Application ---
APP_URL=http://localhost:3000
SESSION_SECRET=
FILE_SIGNING_SECRET=
CRON_SECRET=
# Boîte de réception des demandes de contact (facultatif)
CONTACT_INBOX=

# --- Paiements ---
# mock = simulateur de test (refusé en production sauf ALLOW_MOCK_PAYMENTS=true pour une démo hébergée)
# bank_transfer = virement, confirmation manuelle par un administrateur finance
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
ALLOW_MOCK_PAYMENTS=false
BANK_TRANSFER_INSTRUCTIONS=

# --- Stockage des fichiers ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email / SMS (log = aucun envoi réel, journalisation seulement) ---
EMAIL_PROVIDER=log
EMAIL_HTTP_URL=
EMAIL_HTTP_TOKEN=
EMAIL_FROM=Talent Bridge <no-reply@talentbridge.africa>
SMS_PROVIDER=log
SMS_HTTP_URL=
SMS_HTTP_TOKEN=

# --- Redis (prévu ; non utilisé à ce stade) ---
REDIS_URL=

# --- Démonstration ---
# true = seed de données FICTIVES (marquées « Démo »). Comptes admin de démo jamais créés si NODE_ENV=production.
DEMO_SEED=true
DEMO_PASSWORD=

# --- Tests uniquement ---
# Multiplie les limites de connexion pour les tests E2E (ne pas définir en production)
AUTH_RATE_LIMIT_FACTOR=
LOG_REQUESTS=false
